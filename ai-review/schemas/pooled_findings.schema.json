{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pooled_findings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "critic", "effective_config_sha256", "blind_reviewer_identity", "source_finding_ids", "findings"],
  "properties": {
    "schema_version": {"const": "pooled_findings.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "critic": {"type": "string", "minLength": 1},
    "effective_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blind_reviewer_identity": {"type": "boolean"},
    "source_finding_ids": {
      "type": "object",
      "propertyNames": {"pattern": "^F[0-9]{3,}$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reviewer", "location", "severity", "category", "title", "body", "evidence", "suggestion"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{3,}$"},
          "reviewer": {"type": "string", "minLength": 1},
          "location": {"$ref": "#/$defs/location"},
          "severity": {"enum": ["info", "minor", "major", "blocker"]},
          "category": {"enum": ["security", "correctness", "performance", "maintainability", "style", "test", "other"]},
          "title": {"type": "string", "minLength": 1},
          "body": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "suggestion": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "side", "start_line", "end_line", "symbol"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "side": {"enum": ["new", "old", "unchanged"]},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": ["string", "null"]}
      }
    }
  }
}
