{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consensus.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "merge_request_iid",
    "head_sha",
    "input_manifest_sha256",
    "successful_reviewers",
    "resolution_eligible_reviewers",
    "failed_reviewers",
    "panel_status",
    "groups",
    "summary",
    "run_health"
  ],
  "properties": {
    "schema_version": { "const": "consensus.v3" },
    "run_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string" },
    "merge_request_iid": { "type": "string" },
    "head_sha": { "type": "string" },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "successful_reviewers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Reviewers with adapter_status=success and usable evidence for panel operation (valid empty or at least one accepted finding)."
    },
    "resolution_eligible_reviewers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Reviewers whose batches are usable for absence-based resolution quorum."
    },
    "failed_reviewers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "panel_status": { "enum": ["full", "degraded", "failed"] },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_count",
        "fyi_count"
      ],
      "properties": {
        "surface_count": { "type": "integer", "minimum": 0 },
        "fyi_count": { "type": "integer", "minimum": 0 }
      }
    },
    "run_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "jobs"],
      "description": "Observational run health. It never changes a decision, panel_status, or an exit code.",
      "properties": {
        "grade": { "enum": ["full", "degraded", "rerun_recommended"] },
        "jobs": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/health_job" }
        }
      }
    }
  },
  "$defs": {
    "health_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reviewer",
        "outcome",
        "model",
        "effort",
        "timeout_seconds",
        "duration_ms",
        "raw_finding_count",
        "accepted_finding_count",
        "dropped_finding_count",
        "cap_omitted_finding_count",
        "critique_count",
        "error_class",
        "error_message"
      ],
      "properties": {
        "stage": { "enum": ["review", "critique"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "outcome": {
          "enum": [
            "success",
            "unusable",
            "skipped",
            "timeout",
            "model_error",
            "schema_error",
            "config_error",
            "internal_error",
            "missing"
          ]
        },
        "model": { "type": "string" },
        "effort": { "type": ["string", "null"] },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "raw_finding_count": { "type": ["integer", "null"], "minimum": 0 },
        "accepted_finding_count": { "type": ["integer", "null"], "minimum": 0 },
        "dropped_finding_count": { "type": ["integer", "null"], "minimum": 0 },
        "cap_omitted_finding_count": { "type": ["integer", "null"], "minimum": 0 },
        "critique_count": { "type": ["integer", "null"], "minimum": 0 },
        "error_class": { "type": ["string", "null"], "maxLength": 120 },
        "error_message": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "decision",
        "final_severity",
        "category",
        "title",
        "body",
        "support_count",
        "agreeing_critics",
        "contributing_reviewers",
        "source_finding_ids",
        "candidate_issue_signature_hashes",
        "critique_summary",
        "representative_anchor",
        "all_anchors",
        "match_keys"
      ],
      "properties": {
        "issue_id": { "$ref": "#/$defs/sha256" },
        "decision": { "enum": ["surface", "fyi"] },
        "final_severity": { "enum": ["info", "minor", "major", "blocker"] },
        "category": {
          "enum": [
            "security",
            "correctness",
            "performance",
            "maintainability",
            "style",
            "test",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "suggestion": { "type": ["string", "null"] },
        "evidence_by_reviewer": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          }
        },
        "critique_disputes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["critic", "rationale"],
            "properties": {
              "critic": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "adjusted_severity": {
                "type": ["string", "null"],
                "enum": ["info", "minor", "major", "blocker", null]
              }
            }
          }
        },
        "support_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Unique reviewer identities supporting this group across direct review and critique; two or more surfaces it."
        },
        "agreeing_critics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sorted unique critics whose effective verdict is agree and who did not contribute a direct finding to this group."
        },
        "contributing_reviewers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_finding_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "candidate_issue_signature_hashes": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        },
        "critique_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agree", "dispute", "noise", "duplicate"],
          "properties": {
            "agree": { "type": "integer", "minimum": 0 },
            "dispute": { "type": "integer", "minimum": 0 },
            "noise": { "type": "integer", "minimum": 0 },
            "duplicate": { "type": "integer", "minimum": 0 }
          }
        },
        "representative_anchor": { "type": "object" },
        "all_anchors": {
          "type": "array",
          "items": { "type": "object" }
        },
        "match_keys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path_keys",
            "category",
            "context_hashes",
            "title_fingerprints",
            "symbols"
          ],
          "properties": {
            "path_keys": {
              "type": "array",
              "items": { "type": "string" }
            },
            "category": { "type": "string" },
            "context_hashes": {
              "type": "array",
              "items": { "$ref": "#/$defs/sha256" }
            },
            "title_fingerprints": {
              "type": "array",
              "items": { "$ref": "#/$defs/sha256" }
            },
            "symbols": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
