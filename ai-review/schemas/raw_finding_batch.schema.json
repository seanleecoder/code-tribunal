{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw_finding_batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "side", "start_line", "end_line", "symbol"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "side": {"enum": ["new", "old", "unchanged"]},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "severity", "category", "title", "body", "evidence", "suggestion"],
      "properties": {
        "location": {"$ref": "#/$defs/location"},
        "severity": {"enum": ["info", "minor", "major", "blocker"]},
        "category": {"enum": ["security", "correctness", "performance", "maintainability", "style", "test", "other"]},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "suggestion": {"type": ["string", "null"]}
      }
    }
  }
}
