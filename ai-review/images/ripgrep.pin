# OpenCode v2 searches PATH before its isolated binary cache and the ripgrep
# release download. V2 verifies the downloaded archive, but Tribunal requires the
# image's preinstalled verified binary and fails any runtime download attempt.
#
# Pin the ripgrep release the locked @opencode/cli would otherwise fetch. The
# reviewer image build fails when that OpenCode no longer embeds this version and
# checksum, as a drift signal; the OpenCode image probes establish compatibility. The refresh process
# is ai-review/images/SUPPLY_CHAIN.md step 6.
#
# Two digests, because they cover different things: `sha256` is the release
# tarball, verified at download time in the ripgrep-bin builder stage;
# `binary_sha256` is the extracted `rg` that lands on /usr/local/bin/rg, asserted
# again in the final image stage and at preflight, so what actually resolves on
# the adapter's PATH is checked rather than merely what was downloaded.
version=15.1.0
url=https://github.com/BurntSushi/ripgrep/releases/download/15.1.0/ripgrep-15.1.0-x86_64-unknown-linux-musl.tar.gz
sha256=1c9297be4a084eea7ecaedf93eb03d058d6faae29bbc57ecdaf5063921491599
binary_sha256=ebeaf56f8a25e102e9419933423738b3a2a613a444fd749d695e15eba53f71f2
