{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pip_requirements": {
    "managerFilePatterns": ["/^ai-review/images/python-constraints\\.txt$/"]
  },
  "packageRules": [
    {
      "description": "Release identity: re-pinned by hand in the release commit (ADR-0004 decision 4).",
      "matchPackageNames": ["ghcr.io/seanleecoder/code-tribunal/**"],
      "enabled": false
    },
    {
      "description": "Keep the reviewer CLIs exact; reviewer.Dockerfile installs them with npm ci.",
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    }
  ]
}
